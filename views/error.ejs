<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Naija Dimes Hub</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { margin:0; min-height:100vh; background:#0a0a0a; color:#eee; font-family:'Inter','Segoe UI',system-ui,sans-serif; display:flex; align-items:center; justify-content:center; }
    .error-box { text-align:center; padding:2rem; }
    .error-code { font-size:5rem; font-weight:800; color:#00d4ff; text-shadow:0 0 30px rgba(0,212,255,.4); }
    .error-msg { font-size:1.25rem; color:#888; margin:1rem 0 2rem; }
    .btn { display:inline-block; padding:.75rem 1.5rem; border-radius:8px; font-weight:600; text-decoration:none; background:#00d4ff; color:#000; }
    .btn:hover { transform:translateY(-2px); box-shadow:0 4px 12px rgba(0,212,255,.4); }
  </style>
</head>
<body>
  <div class="error-box">
    <div class="error-code"><%= status || 500 %></div>
    <div class="error-msg"><%= message || 'Something went wrong' %></div>
    <a class="btn" href="/">← Back to Home</a>
  </div>
</body>
</html>
