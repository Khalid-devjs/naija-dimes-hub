<%- include('partials/head') %>
  <div class="card">
    <form method="GET" action="/admin/orders" class="flex" style="margin-bottom:1rem;">
      <input type="text" name="q" placeholder="Search order code / UID / name / WhatsApp" value="<%= query.q || '' %>" style="flex:1; margin-bottom:0;">
      <select name="status" style="width:auto; margin-bottom:0;">
        <option value="">All statuses</option>
        <% Object.keys(LABELS).forEach(s => { %>
          <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= LABELS[s] %></option>
        <% }) %>
      </select>
      <input type="date" name="date" value="<%= query.date || '' %>" style="width:auto; margin-bottom:0;">
      <button type="submit" class="btn btn-p">Filter</button>
    </form>

    <% if (orders.length === 0) { %>
      <p class="muted">No orders found.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Order</th><th>Customer</th><th>UID</th><th>Dimes</th><th>Amount</th><th>Receipt</th><th>Status</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><a href="/admin/orders/<%= o.id %>"><%= o.order_code %></a></td>
              <td><%= o.customer_name %></td>
              <td><%= o.freefire_uid %></td>
              <td><%= o.dimes %></td>
              <td><%= formatNaira(o.amount_kobo) %></td>
              <td>
                <% if (o.receipt) { %>
                  <img class="thumb" src="<%= o.receipt %>" alt="receipt" loading="lazy" title="Click to view receipt">
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <td><span class="badge b-<%= o.status.toLowerCase() %>"><%= LABELS[o.status] || o.status %></span></td>
              <td><span class="muted"><%= o.created_at %></span></td>
              <td><a class="btn btn-p" href="/admin/orders/<%= o.id %>">View</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
<%- include('partials/foot') %>
