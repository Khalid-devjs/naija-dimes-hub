<%- include('partials/head') %>
  <div class="card" style="max-width:720px;">
    <form method="POST" action="/admin/announcements/save">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (a) { %><input type="hidden" name="id" value="<%= a.id %>"><% } %>
      <label>Title *</label>
      <input type="text" name="title" required value="<%= a ? a.title : '' %>">
      <label>Body</label>
      <textarea name="body" rows="4"><%= a ? a.body : '' %></textarea>
      <label>Image URL</label>
      <input type="text" name="image" value="<%= a ? a.image : '' %>">
      <div class="form-row">
        <div><label>Button Text</label><input type="text" name="button_text" value="<%= a ? a.button_text : '' %>"></div>
        <div><label>Button Link</label><input type="text" name="button_link" value="<%= a ? a.button_link : '' %>"></div>
      </div>
      <div class="form-row">
        <div><label>Scheduled At</label><input type="datetime-local" name="scheduled_at" value="<%= a && a.scheduled_at ? a.scheduled_at : '' %>"></div>
        <div><label>Expires At</label><input type="datetime-local" name="expires_at" value="<%= a && a.expires_at ? a.expires_at : '' %>"></div>
      </div>
      <label style="display:flex; align-items:center; gap:.4rem;">
        <input type="checkbox" class="checkbox" name="published" <%= a && a.published ? 'checked' : '' %>> Publish
      </label>
      <button type="submit" class="btn btn-p">Save</button>
      <a class="btn btn-sec" href="/admin/announcements">Cancel</a>
    </form>
  </div>
<%- include('partials/foot') %>
