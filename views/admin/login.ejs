<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login | Naija Dimes Hub</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {background:#0a0a0a; color:#eee; font-family:system-ui, sans-serif; display:flex; align-items:center; justify-content:center; height:100vh; margin:0;}
    .card {background:rgba(255,255,255,.08); padding:2rem 2rem; border-radius:12px; width:300px; text-align:center; box-shadow:0 8px 32px rgba(0,0,0,.5);}
    .card h2 {margin-top:0; color:var(--primary);}
    .form-group {margin-bottom:1rem;}
    input {width:100%; padding:.75rem; margin-top:.5rem; border:1px solid rgba(255,255,255,.2); border-radius:6px; background:rgba(0,0,0,.3); color:var(--text);}
    button {margin-top:1rem; padding:.75rem 1.5rem; background:var(--primary); color:#000; border:none; border-radius:6px; cursor:pointer; font-weight:600;}
    .btn {background:var(--primary); color:#000; border:none; padding:.75rem 1.5rem; border-radius:6px; cursor:pointer; font-weight:600;}
    .btn:hover {background:#00b4e6;}
    .error {color:var(--danger); margin-top:.5rem; display:block;}
  </style>
</head>
<body>
  <div class="card">
    <h2>Admin Login</h2>
    <form method="POST" action="/admin/login">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required placeholder="Enter admin username">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="Enter admin password">
      </div>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <button type="submit" class="btn">Login</button>
    </form>
  </div>
</body>
</html>