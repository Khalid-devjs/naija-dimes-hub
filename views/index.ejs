<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %> Naija Dimes Hub</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {margin:0; min-height:100vh; background:#0a0a0a; color:#eee;}
    .hero {background:url('/img/bg-hero.png') center/cover no-repeat; padding:6rem 1rem; text-align:center;}
    .hero h1 {font-size:4rem; color:#fff; text-shadow:0 0 30px rgba(0,212,255,.4);}
    .hero p {font-size:1.5rem; margin:1rem 0 3rem; max-width:600px; line-height:1.5;}
    .hero .btn {font-weight:600;}
    .section {padding:4rem 1rem; text-align:center;}
    .section h2 {font-size:2rem; color:#fff;}
    .step {display:inline-flex; padding:.75rem 1.5rem; background:#111; border-radius:8px; margin:.5rem; transition:background .2s;}
    .step:hover {background:#222;}
    .step.completed {background:#00c853;}
    .glow {border:2px solid #00d4ff; padding:.3rem .8rem;}
  </style>
</head>
<body>
  <nav class="glow">
    <a href="/" class="glow" style="color:#fff; text-decoration:none;">← Home</a>
  </nav>

  <section class="hero">
    <h1>Get Your Free Fire Diamonds Fast ⚡</h1>
    <p>Secure bank‑transfer payments, instant order creation and admin verification.</p>
    <a href="/buy" class="btn" style="background:#00d4ff; color:#000;">BUY DIMES</a>
    <a href="/track" class="btn s" style="background:#555;">TRACK ORDER</a>
  </section>

  <section class="section">
    <h2>Why Choose Naija Dimes Hub?</h2>
    <div class="step glow"><span>🔓 Exclusive Packages</span></div>
    <div class="step glow"><span>🛡️ 100% Manual Verification</span></div>
    <div class="step glow"><span>🚀 Fast Delivery</span></div>
  </section>

  <section class="section glass">
    <h2>Place Your Order</h2>
    <ol style="max-width:800px;margin:auto;padding:0;">
      <li>Select a Dimes package</li><li>Enter your Free Fire UID</li><li>Provide your details</li><li>Transfer exactly the amount shown</li><li>Upload a screenshot</li><li>Admin verifies → you receive the diamonds</li>
    </ol>
  </section>

  <section class="section glass">
    <h2>Admin Dashboard</h2>
    <p>Manage packages, approve payments, and view analytics.</p>
    <a href="/admin" class="btn">Open Dashboard</a>
  </section>

  <footer style="text-align:center;padding:2rem 1rem;color:#888;font-size:.8rem;background:#111;">
    © <%- (new Date()).getFullYear() %> Naija Dimes Hub – All rights reserved.
  </footer>
</body>
</html>