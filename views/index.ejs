<%- include('layout') %>

  <% if (annBar && annBar.text) { %>
  <div class="announce-bar">📢 <%= annBar.text %></div>
  <% } %>

  <!-- ================= HERO ================= -->
  <section class="hero">
    <img src="/img/hero-bg.svg" alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.6;">
    <span class="float-d" style="top:18%; left:12%; font-size:1.6rem;">💎</span>
    <span class="float-d" style="top:30%; right:15%; font-size:1.2rem; animation-delay:1.2s;">💠</span>
    <span class="float-d" style="bottom:25%; left:22%; font-size:1.4rem; animation-delay:2.1s;">💎</span>
    <span class="float-d" style="bottom:20%; right:25%; font-size:1rem; animation-delay:.6s;">✨</span>
    <div style="position:relative;">
      <h1><span class="grad-text"><%= hero.heading || 'Get Your Free Fire Diamonds Fast ⚡' %></span></h1>
      <p class="hero-desc"><%= hero.description || 'Buy your diamonds easily with secure bank transfer payment and track your order from start to finish.' %></p>
      <div class="hero-btns">
        <a href="/buy" class="btn btn-lg">🛒 <%= hero.button_primary || 'BUY DIMES' %></a>
        <a href="/track" class="btn btn-lg btn-ghost">📍 <%= hero.button_secondary || 'TRACK ORDER' %></a>
      </div>
      <p class="muted mt-2" style="font-size:.85rem;">⚡ Instant delivery after verification &nbsp;•&nbsp; 🏦 Bank transfer only &nbsp;•&nbsp; 🔒 Secure</p>
    </div>
  </section>

  <!-- ================= ANNOUNCEMENT ================= -->
  <% if (announcement) { %>
  <section class="container section" style="padding-top:1rem;">
    <div class="ann-card glass">
      <div class="flex between" style="align-items:center;">
        <div>
          <div class="ann-title">🔥 <%= announcement.title %></div>
          <% if (announcement.body) { %><div class="ann-body"><%= announcement.body %></div><% } %>
        </div>
        <% if (announcement.button_text && announcement.button_link) { %>
          <a href="<%= announcement.button_link %>" class="btn btn-sm"><%= announcement.button_text %></a>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ================= PACKAGES ================= -->
  <section class="container section">
    <h2 class="text-center mb-3">💎 <span class="grad-text">Diamond Packages</span></h2>
    <p class="text-center muted mb-3">Choose your package — pay by bank transfer, upload proof, get your dimes.</p>
    <div class="pkg-grid">
      <% packages.forEach((p) => { %>
        <% const featured = p.featured || p.badge === 'popular'; %>
        <div class="pkg-card <%= featured ? 'featured' : '' %>">
          <% if (p.badge) { %>
            <span class="badge badge-<%= p.badge === 'best_value' ? 'best' : p.badge %> pkg-badge"><%= p.badge === 'popular' ? '⭐ Popular' : p.badge === 'best_value' ? '🔥 Best Value' : '🎁 Promo' %></span>
          <% } %>
          <div class="dimes"><span><%= p.dimes.toLocaleString() %></span> Dimes</div>
          <% if (p.old_price_kobo) { %><div class="old-price"><%= formatNaira(p.old_price_kobo) %></div><% } %>
          <div class="price"><%= formatNaira(p.price_kobo) %></div>
          <a href="/buy" class="btn btn-block buy-btn"><%= p.badge === 'promo' ? '🎁 Grab Deal' : 'BUY NOW' %></a>
        </div>
      <% }) %>
    </div>
    <% if (packages.length === 0) { %>
      <div class="empty"><div class="empty-ic">💎</div><p>Packages coming soon!</p></div>
    <% } %>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section class="container section">
    <h2 class="text-center mb-3">⚡ <span class="grad-text">How It Works</span></h2>
    <div class="grid-3">
      <div class="card text-center card-hover"><div class="step-num" style="margin:0 auto .8rem;">1</div><h3>Pick a Package</h3><p class="muted" style="font-size:.9rem;">Choose how many diamonds you need.</p></div>
      <div class="card text-center card-hover"><div class="step-num" style="margin:0 auto .8rem;">2</div><h3>Pay &amp; Upload</h3><p class="muted" style="font-size:.9rem;">Transfer to our bank account and upload your receipt.</p></div>
      <div class="card text-center card-hover"><div class="step-num" style="margin:0 auto .8rem;">3</div><h3>Get Your Dimes</h3><p class="muted" style="font-size:.9rem;">We verify and deliver straight to your Free Fire UID.</p></div>
    </div>
  </section>

  <!-- ================= TESTIMONIALS ================= -->
  <% if (testimonials.length > 0) { %>
  <section class="container section">
    <h2 class="text-center mb-3">💬 <span class="grad-text">What Customers Say</span></h2>
    <div class="grid-3">
      <% testimonials.forEach((t) => { %>
        <div class="card card-hover">
          <div style="color:var(--gold); letter-spacing:2px;">★<%= '★'.repeat(Math.max(0, t.rating - 1)) %></div>
          <p style="margin:.6rem 0; font-size:.92rem;"><%= t.text %></p>
          <div class="muted" style="font-size:.82rem;">— <%= t.customer_name %></div>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- ================= CTA ================= -->
  <section class="container section text-center">
    <div class="glass" style="padding:3rem 1.5rem;">
      <h2 class="mb-2">Ready to top up? <span class="grad-text">⚡</span></h2>
      <p class="muted mb-3">Join hundreds of gamers getting their diamonds fast.</p>
      <a href="/buy" class="btn btn-lg">🛒 BUY DIMES NOW</a>
    </div>
  </section>

<%- include('partials/footer') %>
