<%- include('layout') %>

  <% if (annBar && annBar.text) { %>
  <div class="announce-bar">📢 <%= annBar.text %></div>
  <% } %>

  <!-- ================= HERO ================= -->
  <section class="hero">
    <img src="/img/hero-bg.svg" alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.6;">
    <span class="float-d" style="top:18%; left:12%; font-size:1.6rem;">💎</span>
    <span class="float-d" style="top:30%; right:15%; font-size:1.2rem; animation-delay:1.2s;">💠</span>
    <span class="float-d" style="bottom:25%; left:22%; font-size:1.4rem; animation-delay:2.1s;">💎</span>
    <span class="float-d" style="bottom:20%; right:25%; font-size:1rem; animation-delay:.6s;">✨</span>
    <div style="position:relative;">
      <h1><span class="grad-text"><%= hero.heading || 'Get Your Game Items Fast ⚡' %></span></h1>
      <p class="hero-desc"><%= hero.description || 'Pick your game, choose a package, pay by bank transfer, and we deliver fast.' %></p>
      <p class="muted mt-2" style="font-size:.85rem;">⚡ Instant delivery after verification &nbsp;•&nbsp; 🏦 Bank transfer only &nbsp;•&nbsp; 🔒 Secure &nbsp;•&nbsp; 🔑 UID/ID only — no password ever needed</p>
    </div>
  </section>

  <!-- ================= GAME STORES ================= -->
  <section class="container section">
    <h2 class="text-center mb-2">🎮 <span class="grad-text">Choose Your Game Store</span></h2>
    <p class="text-center muted mb-3">Tap a game to enter its own store.</p>
    <div class="game-grid">
      <% games.forEach((g) => { %>
        <a href="/store/<%= g.slug %>" class="game-card" style="--game-color:<%= g.color %>;">
          <div class="game-emoji"><%= g.emoji %></div>
          <div class="game-name"><%= g.name %></div>
          <div class="game-tag"><%= g.tagline %></div>
          <div class="game-enter">Enter Store →</div>
        </a>
      <% }) %>
    </div>
  </section>

  <!-- ================= ANNOUNCEMENT ================= -->
  <% if (announcement) { %>
  <section class="container section" style="padding-top:0;">
    <div class="ann-card glass">
      <div class="flex between" style="align-items:center;">
        <div>
          <div class="ann-title">🔥 <%= announcement.title %></div>
          <% if (announcement.body) { %><div class="ann-body"><%= announcement.body %></div><% } %>
        </div>
        <% if (announcement.button_text && announcement.button_link) { %>
          <a href="<%= announcement.button_link %>" class="btn btn-sm"><%= announcement.button_text %></a>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ================= TESTIMONIALS ================= -->
  <% if (testimonials.length > 0) { %>
  <section class="container section">
    <h2 class="text-center mb-3">💬 <span class="grad-text">What Customers Say</span></h2>
    <div class="grid-3">
      <% testimonials.forEach((t) => { %>
        <div class="card card-hover">
          <div style="color:var(--gold); letter-spacing:2px;">★<%= '★'.repeat(Math.max(0, t.rating - 1)) %></div>
          <p style="margin:.6rem 0; font-size:.92rem;"><%= t.text %></p>
          <div class="muted" style="font-size:.82rem;">— <%= t.customer_name %></div>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- ================= CTA ================= -->
  <section class="container section text-center">
    <div class="glass" style="padding:3rem 1.5rem;">
      <h2 class="mb-2">Ready to top up? <span class="grad-text">⚡</span></h2>
      <p class="muted mb-3">Join thousands of gamers getting their items fast.</p>
      <a href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;" class="btn btn-lg">🎮 Pick Your Game</a>
    </div>
  </section>

<%- include('partials/footer') %>
