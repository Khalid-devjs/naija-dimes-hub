<%- include('layout') %>
  <div class="timeline">
    <div class="step done"><span class="check">✓</span><span class="label">Select Package</span></div>
    <div class="step"><span class="label">Enter Free Fire UID</span></div>
    <div class="step"><span class="label">Your Information</span></div>
    <div class="step"><span class="label">Create Order</span></div>
    <div class="step"><span class="label">Bank Transfer</span></div>
    <div class="step"><span class="label">Upload Screenshot</span></div>
    <div class="step"><span class="label">Admin Approval</span></div>
  </div>
  <% if (error) { %>
    <div class="card" style="background:rgba(255,0,0,.1); border-color:rgba(255,0,0,.3); margin-bottom:1rem;">
      <h3 style="color:var(--danger);"><%= error %></h3>
    </div>
  <% } %>
  <div class="card glow" style="max-width:800px; margin:0 auto;">
    <h1 style="text-align:center;">Enter Your Free Fire UID</h1>
    <p style="color:var(--muted); text-align:center;">You selected: <strong style="color:var(--primary);"><%= package.dimes %> Dimes</strong> for <strong style="color:var(--primary);">₦<%= formatNairaShort(package.price_kobo) %></strong></p>
    <form method="POST" action="/buy/uid">
      <input type="hidden" name="package_id" value="<%= package.id %>">
      <div class="form-group" style="margin-bottom:1rem;">
        <label for="uid">Free Fire UID *</label>
        <input type="text" id="uid" name="uid" required value="<%= uid || '' %>" pattern="\d{5,12}" placeholder="e.g. 1234567890">
        <p style="color:var(--muted); font-size:.8rem;">Enter your Free Fire UID carefully. Diamonds will be sent to the UID provided.</p>
      </div>
      <div class="form-group" style="margin-bottom:1rem;">
        <label for="nick">Free Fire Nickname (optional)</label>
        <input type="text" id="nick" name="nick" value="<%= nick || '' %>" placeholder="Your Free Fire nickname">
      </div>
      <div style="text-align:center; margin:1rem 0;">
        <label style="display:flex; align-items:center; gap:.5rem; justify-content:center; cursor:pointer;">
          <input type="checkbox" required style="transform:scale(1.3);">
          <span>I confirm that my Free Fire UID is correct.</span>
        </label>
      </div>
      <button type="submit" class="btn btn-block">Continue</button>
    </form>
  </div>
<%- include('partials/footer') %>
