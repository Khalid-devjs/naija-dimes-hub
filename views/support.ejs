<%- include('layout') %>
  <h1>Support</h1>
  <p style="color:var(--muted);">Need help with your order? Reach us through any channel below.</p>

  <div class="flex" style="max-width:700px; margin:0 auto; gap:1rem;">
    <% if (whatsapp) { %>
    <div class="card glow" style="flex:1 1 200px; text-align:center;">
      <h2 style="color:var(--accent);">WhatsApp</h2>
      <p><%= whatsapp %></p>
      <a class="btn" href="https://wa.me/<%= whatsapp.replace(/\D/g,'') %>">Chat Now</a>
    </div>
    <% } %>
    <% if (telegram) { %>
    <div class="card glow" style="flex:1 1 200px; text-align:center;">
      <h2 style="color:var(--primary);">Telegram</h2>
      <p><%= telegram %></p>
      <a class="btn" href="https://t.me/<%= telegram.replace(/^@/,'') %>">Message Us</a>
    </div>
    <% } %>
    <% if (email) { %>
    <div class="card glow" style="flex:1 1 200px; text-align:center;">
      <h2 style="color:var(--primary);">Email</h2>
      <p><%= email %></p>
      <a class="btn" href="mailto:<%= email %>">Send Email</a>
    </div>
    <% } %>
  </div>

  <% if (!whatsapp && !telegram && !email) { %>
    <div class="card" style="max-width:600px; margin:1rem auto;">
      <p>Support channels coming soon.</p>
    </div>
  <% } %>
<%- include('partials/footer') %>
