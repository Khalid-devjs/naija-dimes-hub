<%- include('layout') %>
  <section class="container section" style="max-width:720px;">
    <h1 class="text-center">📞 <span class="grad-text">Support</span></h1>
    <p class="text-center muted mb-3">Need help with your order? Reach us on any channel.</p>
    <div class="grid-3">
      <% if (whatsapp) { %>
      <div class="card card-hover text-center">
        <div style="font-size:2.2rem;">💬</div>
        <h3 style="color:var(--accent);">WhatsApp</h3>
        <p class="muted"><%= whatsapp %></p>
        <a class="btn btn-accent btn-block" href="https://wa.me/<%= whatsapp.replace(/\D/g,'') %>">Chat Now</a>
      </div>
      <% } %>
      <% if (telegram) { %>
      <div class="card card-hover text-center">
        <div style="font-size:2.2rem;">✈️</div>
        <h3 style="color:var(--primary);">Telegram</h3>
        <p class="muted"><%= telegram %></p>
        <a class="btn btn-block" href="https://t.me/<%= telegram.replace(/^@/,'') %>">Message Us</a>
      </div>
      <% } %>
      <% if (email) { %>
      <div class="card card-hover text-center">
        <div style="font-size:2.2rem;">📧</div>
        <h3 style="color:var(--primary);">Email</h3>
        <p class="muted"><%= email %></p>
        <a class="btn btn-ghost btn-block" href="mailto:<%= email %>">Send Email</a>
      </div>
      <% } %>
    </div>
    <% if (!whatsapp && !telegram && !email) { %>
      <div class="empty"><div class="empty-ic">📞</div><p>Support channels coming soon.</p></div>
    <% } %>
  </section>
<%- include('partials/footer') %>
