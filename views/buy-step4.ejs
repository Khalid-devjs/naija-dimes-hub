<%- include('layout') %>
  <section class="container section" style="max-width:760px;">
    <div class="timeline mb-3">
      <div class="step done"><span class="check">✓</span><span class="label">Select Package</span></div>
      <div class="step done"><span class="check">✓</span><span class="label">Enter Free Fire UID</span></div>
      <div class="step done"><span class="check">✓</span><span class="label">Your Information</span></div>
      <div class="step done"><span class="check">✓</span><span class="label">ORDER CREATED</span></div>
    </div>

    <div class="card text-center" style="background:linear-gradient(135deg, rgba(0,212,255,.12), rgba(0,255,136,.16));">
      <h2 style="color:var(--accent);">✅ Order Created</h2>
      <p class="muted">Your order has been generated. Complete the payment below to proceed.</p>
      <div style="background:rgba(0,0,0,.35); padding:1.5rem; border-radius:12px; margin:1rem 0;">
        <p><strong>Order ID:</strong> <span style="color:var(--primary); font-family:monospace; font-size:1.1rem;"><%= order.code %></span>
          <button class="btn btn-ghost btn-sm" data-copy="<%= order.code %>" style="margin-left:.5rem;">📋 Copy</button>
        </p>
        <p><strong>Dimes:</strong> <%= order.dimes.toLocaleString() %></p>
        <p><strong>Amount:</strong> <span style="color:var(--accent); font-size:1.6rem; font-weight:800;"><%= formatNaira(order.amount) %></span>
          <button class="btn btn-ghost btn-sm" data-copy="<%= formatNaira(order.amount) %>">📋 Copy</button>
        </p>
        <p><strong><%= game.accountLabel %>:</strong> <%= order.uid %></p>
        <p><strong>Status:</strong> <span class="status-badge st-pending">🔴 Payment Pending</span></p>
      </div>
    </div>

    <div class="card mt-3">
      <h2 style="color:var(--primary);">🏦 Bank Transfer</h2>
      <p class="muted">Transfer the exact amount to the account below, then upload your receipt.</p>
      <div style="background:rgba(0,0,0,.35); padding:1.25rem; border-radius:12px; margin:1rem 0;">
        <% const ps = paymentSettings || {}; %>
        <p><strong>Bank:</strong> <%= ps.bank_name || 'GTBank' %></p>
        <p><strong>Account Name:</strong> <%= ps.account_name || 'NAIJA DIMES HUB' %></p>
        <div class="copy-row"><span class="val"><%= ps.account_number || '0000000000' %></span>
          <button class="btn btn-accent btn-sm copy-btn" data-copy="<%= ps.account_number || '0000000000' %>">📋 Copy</button>
        </div>
        <p class="muted" style="font-size:.85rem;"><%= ps.reference_note || 'Use your Order ID as the transfer reference' %></p>
      </div>
      <h3>Payment Instructions</h3>
      <ol class="muted" style="padding-left:1.4rem; line-height:2;">
        <li>Open your banking app.</li>
        <li>Transfer the exact amount shown: <strong style="color:var(--text);"><%= formatNaira(order.amount) %></strong></li>
        <li>Complete the transaction.</li>
        <li>Save your payment receipt.</li>
        <li>Return to Naija Dimes Hub.</li>
        <li>Upload your payment screenshot.</li>
        <li>Submit your payment for verification.</li>
        <li>Wait for admin approval.</li>
      </ol>
      <a href="/buy/upload/<%= order.id %>" class="btn btn-lg btn-block mt-2">📸 Upload Payment Screenshot</a>
      <a href="/track" class="btn btn-ghost btn-block mt-1">Track Order</a>
    </div>
  </section>
<%- include('partials/footer') %>
