<%- include('layout') %>
  <section class="container section" style="max-width:720px;">
    <div class="timeline mb-3">
      <div class="step done"><span class="check">✓</span><span class="label">Select Package</span></div>
      <div class="step done"><span class="check">✓</span><span class="label">Enter Free Fire UID</span></div>
      <div class="step active"><span class="label">Your Information</span></div>
      <div class="step"><span class="label">Create Order</span></div>
    </div>
    <% if (error) { %>
      <div class="card" style="background:rgba(255,71,87,.1); border-color:rgba(255,71,87,.4); margin-bottom:1rem;">
        <h3 style="color:var(--danger);">⚠️ <%= error %></h3>
      </div>
    <% } %>
    <div class="card glow" style="max-width:560px; margin:0 auto;">
      <h1 style="text-align:center;">Your Information</h1>
      <p class="muted" style="text-align:center;">So we can contact you about your order.</p>
      <form method="POST" action="/buy/info">
        <input type="hidden" name="package_id" value="<%= package.id %>">
        <input type="hidden" name="uid" value="<%= uid %>">
        <input type="hidden" name="nick" value="<%= nick %>">
        <label for="name">Full Name *</label>
        <input type="text" id="name" name="name" required value="<%= name || '' %>" placeholder="Your full name">
        <label for="whatsapp">WhatsApp Number *</label>
        <input type="text" id="whatsapp" name="whatsapp" required value="<%= whatsapp || '' %>" placeholder="+234 803 xxx xxxx">
        <label for="email">Email Address (optional)</label>
        <input type="email" id="email" name="email" value="<%= email || '' %>" placeholder="you@example.com">
        <label for="note">Customer Note (optional)</label>
        <textarea id="note" name="note" placeholder="Any special instructions?"><%= note || '' %></textarea>
        <button type="submit" class="btn btn-block btn-lg">Create Order →</button>
      </form>
    </div>
  </section>
<%- include('partials/footer') %>
