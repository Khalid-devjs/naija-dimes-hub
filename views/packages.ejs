<%- include('layout') %>
  <h1>Diamond Packages</h1>
  <p style="color:var(--muted);">Prices can be adjusted in the Admin Dashboard.</p>
  <div class="flex flex-wrap" style="gap:1rem;">
    <% packages.forEach(p => { %>
      <div class="card glow" style="flex:1 1 250px; max-width:280px;">
        <h3 style="color:var(--primary);">💎 <%= p.dimes %> Dimes</h3>
        <p>₦<%= formatNairaShort(p.price_kobo) %></p>
        <% if (p.badge) { %>
          <span class="badge badge-<%= p.badge %>"><%= p.badge %></span>
        <% } %>
        <p style="color:var(--muted); font-size:.85rem;">Active: <%= p.active ? 'Yes' : 'No' %></p>
      </div>
    <% }) %>
  </div>
<%- include('partials/footer') %>
