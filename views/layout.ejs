<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%- title %> | <%= site.store_name || 'Naija Dimes Hub' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <style>
    :root {
      --bg: #0a0a0a;
      --card: rgba(255,255,255,.08);
      --primary: #00d4ff;
      --accent: #00ff88;
      --danger: #ff4757;
      --text: #eee;
      --muted: #888;
    }
    * { box-sizing: border-box; }
    body {
      margin:0; padding:0;
      min-height:100vh;
      font-family: 'Inter','Segoe UI',system-ui,sans-serif;
      background: linear-gradient(135deg,#0a0a0a,#030303);
      color: var(--text);
      overflow-x:hidden;
    }
    .glass {
      background: var(--card);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,.1);
      box-shadow: 0 8px 32px rgba(0,0,0,.4);
      border-radius: 16px;
      padding: 2rem;
    }
    .glow {
      box-shadow: 0 0 20px rgba(0,212,255,.4), 0 0 40px rgba(0,212,255,.2);
    }
    .btn {
      display: inline-block;
      padding: .75rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all .2s ease;
      background: var(--primary);
      color: #000;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,212,255,.4); }
    .btn-danger { background: var(--danger); color:#fff; }
    .btn-secondary { background: var(--muted); color:#000; }
    .btn-block { width:100%; text-align:center; display:block; margin:.5rem 0; }
    h1,h2,h3,h4 { margin:0 0 .5rem 0; font-weight: 600; color: #fff; }
    .text-center { text-align:center; }
    .flex { display:flex; flex-wrap:wrap; gap:1rem; }
    .flex-center { align-items:center; justify-content:center; }
    .card { background: var(--card); border-radius:12px; padding:1.5rem; }
    .badge {
      display:inline-block; padding:.25rem .5rem;
      font-size:.75rem; font-weight:600;
      border-radius:4px; margin-left:.5rem;
    }
    .badge-popular { background:#ffb800; color:#000; }
    .badge-best { background:#00ff88; color:#000; }
    .badge-promo { background:#ff006e; color:#fff; }
    input, select, textarea {
      width:100%; padding:.75rem;
      border:1px solid rgba(255,255,255,.2);
      border-radius:8px;
      background: rgba(0,0,0,.3);
      color: var(--text);
    }
    input::placeholder { color: var(--muted); }
    textarea { min-height:120px; resize:vertical; }
    .img-preview { max-width:200px; max-height:150px; border-radius:8px; margin-top:.5rem; }
    .status-badge {
      padding:.25rem .5rem; border-radius:4px; font-size:.75rem; font-weight:600;
    }
    .status-pending { background:#ff9f43; color:#000; }
    .status-approved { background:#00c853; color:#fff; }
    .status-rejected { background:#ff5252; color:#fff; }
    .status-more { background:#ffab00; color:#000; }
    .status-under { background:#37474f; color:#fff; }
    .status-complete { background:#00c853; color:#fff; }
    .status-cancelled { background:#555; color:#fff; }
    .status-refunded { background:#666; color:#fff; }
    .timeline { position:relative; padding-left:2rem; }
    .timeline::before { content:''; position:absolute; left:0; top:0; bottom:0; width:2px; background:rgba(255,255,255,.1); }
    .step { position:relative; margin-bottom:1rem; }
    .step::before { content:''; position:absolute; left:-2.5rem; top:.2rem; width:12px; height:12px; border-radius:50%; background:var(--primary); border:3px solid var(--bg); }
    .step.done .check { display:block; }
    .step .check { content:'✓'; position:absolute; left:-2.5rem; top:.2rem; font-size:14px; color:var(--primary); display:none; }
    .step .label { color:var(--text); }
    .step.done .label { color:var(--muted); text-decoration:line-through; }
    table { width:100%; border-collapse:collapse; }
    th, td { padding:.75rem; text-align:left; border-bottom:1px solid rgba(255,255,255,.1); }
    th { color:var(--muted); }
    .hidden { display:none; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container" style="max-width:1200px; margin:0 auto; padding:2rem 1rem;">
    <%- body %>
  </main>
  <%- include('partials/footer') %>

  <% if (session?.admin) { %>
  <script>
    window.ADMIN = {
      id: <%= JSON.stringify(session.admin.id) %>,
      username: "<%= session.admin.username %>",
      role: "<%= session.admin.role %>"
    };
  </script>
  <% } %>
</body>
</html>