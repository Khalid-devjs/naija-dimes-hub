<%- include('layout') %>
  <section class="container section" style="max-width:680px;">
    <div class="timeline mb-3">
      <div class="step done"><span class="check">✓</span><span class="label">Order Created</span></div>
      <div class="step done"><span class="check">✓</span><span class="label">Bank Transfer</span></div>
      <div class="step active"><span class="label">Upload Payment Screenshot</span></div>
      <div class="step"><span class="label">Admin Approval</span></div>
    </div>
    <% if (error) { %>
      <div class="card" style="background:rgba(255,71,87,.1); border-color:rgba(255,71,87,.4); margin-bottom:1rem;">
        <h3 style="color:var(--danger);">⚠️ <%= error %></h3>
      </div>
    <% } %>
    <div class="card glow">
      <h1 style="text-align:center;">📸 Upload Payment Screenshot</h1>
      <p class="muted" style="text-align:center;">Upload a clear screenshot of your bank transfer.</p>
      <form method="POST" action="/payment/<%= order.id %>/upload" enctype="multipart/form-data">
        <input type="hidden" name="order_id" value="<%= order.id %>">
        <label for="screenshot">Payment Screenshot *</label>
        <input type="file" id="screenshot" name="screenshot" accept="image/*" required>
        <div id="preview" style="text-align:center; margin:.5rem 0;"></div>
        <p class="muted" style="font-size:.8rem;">Allowed: JPG, JPEG, PNG, WEBP • Max 5 MB</p>
        <label for="ref">Transaction Reference *</label>
        <input type="text" id="ref" name="transaction_ref" required placeholder="e.g. FT20260809ABCD123">
        <label for="sender">Sender Name (as on bank account)</label>
        <input type="text" id="sender" name="sender_name" placeholder="Your full name">
        <label for="amount">Amount Paid (₦) *</label>
        <input type="number" id="amount" name="amount_paid" step="0.01" min="0" required>
        <label for="date">Payment Date *</label>
        <input type="date" id="date" name="payment_date" required>
        <p class="muted" style="font-size:.8rem;">⚠️ Double-check that the amount matches exactly what was shown on the order page.</p>
        <button type="submit" class="btn btn-lg btn-block mt-2">✅ Submit Payment</button>
        <a href="/track" class="btn btn-ghost btn-block mt-1">Track Order</a>
      </form>
    </div>
  </section>
<%- include('partials/footer') %>
